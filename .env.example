# =============================================================================
# Dashboard de Insights do Instagram — variáveis de ambiente
# -----------------------------------------------------------------------------
# A aplicação sobe e renderiza todas as telas mesmo sem credenciais: sem token,
# as métricas rodam em MODO DEMONSTRAÇÃO (dados fictícios, sinalizados na UI).
# Copie para `.env`:  cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Banco de dados (PostgreSQL)
# -----------------------------------------------------------------------------
# Na Railway, o serviço Postgres injeta esta variável (use a Reference Variable
# ${{Postgres.DATABASE_URL}}). Localmente, aponte para um Postgres seu.
DATABASE_URL="postgresql://user:password@localhost:5432/dashboard?schema=public"

# -----------------------------------------------------------------------------
# Acesso / Login
# -----------------------------------------------------------------------------
AUTH_SECRET=                 # OBRIGATÓRIO em produção (assina a sessão)
APP_AUTH_USER=               # opcional: troca o usuário (default: hacecompany)
APP_AUTH_PASSWORD=           # opcional: troca a senha (em texto, só no ambiente)
APP_AUTH_PASSWORD_HASH=      # alternativa: sha256 hex da senha

# -----------------------------------------------------------------------------
# Instagram (Graph API via Facebook)
# -----------------------------------------------------------------------------
# Requer conta Business/Creator ligada a uma Página do Facebook, e um app em
# developers.facebook.com com o produto "Instagram Graph API".
#
# Permissões (OAuth) para gerar o token de longa duração:
#   instagram_basic, instagram_manage_insights, pages_show_list, pages_read_engagement
#
# MODO DEMONSTRAÇÃO: com IG_FIXTURE=1 (ou sem token), a dash usa dados fictícios.
IG_FIXTURE=

META_APP_ID=                 # App ID do app na Meta
META_APP_SECRET=             # App Secret (só no servidor)
IG_USER_ID=                  # ID da conta profissional do Instagram (IG User ID)
IG_ACCESS_TOKEN=             # Token de acesso de longa duração (~60 dias)
META_API_VERSION=v21.0       # versão da Graph API

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
APP_TIMEZONE=America/Sao_Paulo
NEXT_PUBLIC_APP_URL=http://localhost:3000
