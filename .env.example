# =============================================================================
# Dashboard Omnichannel — variáveis de ambiente
# -----------------------------------------------------------------------------
# A aplicação SOBE E RENDERIZA TODAS AS TELAS mesmo com este arquivo vazio.
# Sem credenciais, cada fonte cai automaticamente em modo demonstração (mock),
# de forma independente: a Shopify pode estar conectada de verdade enquanto a
# loja física ainda roda em mock, e vice-versa.
#
# Copie para `.env` e preencha o que tiver:  cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Banco de dados (PostgreSQL)
# -----------------------------------------------------------------------------
# Produção e dev usam Postgres. Na Vercel, criar um Vercel Postgres/Neon já
# injeta esta variável. Local: use um Postgres (Docker/Neon) e rode as migrations
# com `npm run db:migrate` (ou `npm run db:migrate:dev` para criar novas).
DATABASE_URL="postgresql://user:password@localhost:5432/dashboard?schema=public"

# -----------------------------------------------------------------------------
# Sincronização (proteção dos endpoints /api/sync/*)
# -----------------------------------------------------------------------------
# Segredo para disparar sync manualmente: ?secret=... ou header x-sync-secret.
SYNC_SECRET=
# Definido automaticamente pelo Vercel Cron. Se você setar, o cron manda
# Authorization: Bearer <CRON_SECRET> e os endpoints de sync exigem isso.
CRON_SECRET=

# -----------------------------------------------------------------------------
# FONTE 1 — Shopify (loja online)
# -----------------------------------------------------------------------------
# Domínio .myshopify.com da loja. Ex: minhaloja.myshopify.com
SHOPIFY_STORE_DOMAIN=

# Admin API access token do custom app. Começa com "shpat_".
# Aparece UMA ÚNICA VEZ ao instalar o app — copie na hora.
# Como gerar:
#   Admin Shopify → Configurações → Apps e canais de vendas →
#   Desenvolver apps → Criar um app → Configurar escopos da Admin API →
#   Instalar o app → revelar o Admin API access token.
# Escopos necessários:
#   read_orders, read_products, read_customers, read_inventory,
#   read_marketing_events, read_reports
# (read_orders cobre só os últimos 60 dias; histórico completo exige
#  read_all_orders, que precisa de aprovação da Shopify — ver README.)
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Versão da Admin API GraphQL (formato AAAA-MM).
SHOPIFY_API_VERSION=2025-01

# Segredo para validar o HMAC dos webhooks (orders/create, orders/updated,
# orders/paid, orders/cancelled, refunds/create).
SHOPIFY_WEBHOOK_SECRET=

# MODO FICTÍCIO (demonstração): com SHOPIFY_FIXTURE=1 a fonte online fica
# "conectada" e alimenta o pipeline REAL (validação Zod -> mapper de UTM ->
# agrupamento de canal -> banco) com payloads fictícios, sem rede nem
# credenciais. Deixe vazio/0 para usar a Admin API real (exige domínio+token).
SHOPIFY_FIXTURE=

# -----------------------------------------------------------------------------
# FONTE 2 — Loja física (PDV / ERP)
# -----------------------------------------------------------------------------
# Sistema usado pela loja física.
# Valores aceitos: bling | tiny | omie | linx | totvs | shopify_pos | custom
PDV_SYSTEM=

# URL base da API do sistema de PDV/ERP.
PDV_API_BASE_URL=

# Credenciais de acesso.
PDV_API_KEY=
PDV_API_SECRET=

# Tipo de autenticação usado pela API do PDV.
# Valores aceitos: bearer | apikey_header | oauth2 | basic
PDV_AUTH_TYPE=

# ID da unidade/loja, quando o sistema tem múltiplas unidades.
PDV_STORE_ID=

# MODO FICTÍCIO (demonstração): com PDV_FIXTURE=1 a loja física fica "conectada"
# e alimenta o pipeline REAL (mapper por sistema -> banco) com vendas fictícias
# (sistema padrão: bling), sem rede nem credenciais. Deixe vazio/0 para a API real.
PDV_FIXTURE=

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
# Fuso horário usado em toda formatação de data (não altere sem motivo).
APP_TIMEZONE=America/Sao_Paulo

# URL pública da aplicação (usada para montar callbacks/webhooks).
NEXT_PUBLIC_APP_URL=http://localhost:3000
